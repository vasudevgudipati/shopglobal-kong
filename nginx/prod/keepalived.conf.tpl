global_defs {
  script_user root
  enable_script_security   # health-check script is root-owned in a root-owned folder
}

vrrp_script chk_nginx {
  script "/etc/keepalived/check_nginx.sh"
  interval 2
  fall 2
  rise 2
}

vrrp_instance SHOPGLOBAL_PROD_EDGE {
  state __STATE__
  interface __IFACE__
  virtual_router_id __VRID__
  priority __PRIORITY__
  advert_int 1
  unicast_src_ip __SELF_IP__
