# ON HOLD - not applied. To enable: move the strategy below into ai-gateway.yaml and add, on every model and the MCP server:
#   access:
#     auth_strategies:
#       - !ref auth-keycloak#name
#
# ---------------------------------------------------------------- authentication (Keycloak)
ai_gateway_auth_strategies:
  - ref: auth-keycloak
    ai_gateway: !ref shopglobal-ai-uat
    name: shopglobal-keycloak
    display_name: ShopGlobal Keycloak
    type: openid-connect
    config:
      issuer: https://marmalade-ivy-crazed.ngrok-free.dev/realms/demo
      client_id:
        - kong-ai-admin
      client_secret:
        - !secret {source: !env KEYCLOAK_AI_CLIENT_SECRET}
      auth_methods:
        - bearer
      scopes:
        - openid
      cache_tokens_salt: shopglobal-keycloak-uat
      consumer_optional: true
