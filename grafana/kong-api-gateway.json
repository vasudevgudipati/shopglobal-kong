   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(kong_request_latency_ms_bucket{gateway=\"api\"}[5m])) by (le, service))",
     "legendFormat": "{{service}}"
    }
   ]
  },
