{
 "uid": "shopglobal-kong-api",
 "title": "ShopGlobal - API Gateway (UAT)",
 "tags": [
  "shopglobal",
  "kong",
  "api"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests/s by service",
   "datasource": {
    "type": "prometheus",
    "uid": "shopglobal-prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(kong_http_requests_total{gateway=\"api\"}[1m])) by (service)",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Requests/s by status code",
   "datasource": {
    "type": "prometheus",
    "uid": "shopglobal-prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(kong_http_requests_total{gateway=\"api\"}[1m])) by (code)",
     "legendFormat": "{{code}}"
    }
   ]
  },
  {
