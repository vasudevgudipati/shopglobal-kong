        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(kong_ai_llm_provider_latency_ms_bucket{gateway=\"ai\",env=\"prod\"}[5m])) by (le, ai_model))",
          "legendFormat": "{{ai_model}}"
