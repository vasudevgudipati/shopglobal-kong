{
  "uid": "shopglobal-kong-ai-prod",
  "title": "ShopGlobal - AI Gateway (PROD)",
  "tags": [
    "shopglobal",
    "kong",
    "ai"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "LLM requests/s by model",
      "datasource": {
        "type": "prometheus",
        "uid": "shopglobal-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kong_ai_llm_requests_total{gateway=\"ai\",env=\"prod\"}[5m])) by (ai_model)",
          "legendFormat": "{{ai_model}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tokens per hour by model",
      "datasource": {
        "type": "prometheus",
        "uid": "shopglobal-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kong_ai_llm_tokens_total{gateway=\"ai\",env=\"prod\"}[1h])) by (ai_model, token_type)",
          "legendFormat": "{{ai_model}} {{token_type}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tokens per hour by consumer",
      "datasource": {
        "type": "prometheus",
        "uid": "shopglobal-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kong_ai_llm_tokens_total{gateway=\"ai\",env=\"prod\"}[1h])) by (consumer)",
          "legendFormat": "{{consumer}}"
        }
      ]
    },
    {
      "id": 4,
