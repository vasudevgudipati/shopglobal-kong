<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.shopglobal</groupId>
  <artifactId>shopglobal-mock-api</artifactId>
  <version>1.0.0</version>
  <name>shopglobal-mock-api</name>
  <description>ShopGlobal mock upstream APIs (products, orders, returns, address) for the Kong blueprint</description>

  <properties>
    <java.version>17</java.version>
    <!-- UAT is the default build. Use -Pprod for the production build. -->
    <app.env>UAT</app.env>
    <build.suffix>uat</build.suffix>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Plain JDBC (JdbcTemplate + Hikari). No JPA: Hibernate 6 does not support Oracle 11g. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- Oracle 11g XE on the Windows server is the only database (no embedded/local database). Version managed by Spring Boot. -->
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc8</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Generates the OpenAPI spec that is published to the Konnect portal and converted to MCP tools -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>2.6.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>uat</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <properties><app.env>UAT</app.env><build.suffix>uat</build.suffix></properties>
    </profile>
    <profile>
      <id>prod</id>
      <properties><app.env>PROD</app.env><build.suffix>prod</build.suffix></properties>
    </profile>
  </profiles>

  <build>
    <finalName>shopglobal-mock-api-${build.suffix}</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
