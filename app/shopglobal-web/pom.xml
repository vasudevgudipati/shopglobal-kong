<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.shopglobal</groupId>
  <artifactId>shopglobal-web</artifactId>
  <version>1.0.0</version>
  <name>shopglobal-web</name>
  <description>ShopGlobal storefront and shopping-assistant chatbot</description>

  <properties>
    <java.version>17</java.version>
    <!-- UAT is the default build. Use -Pprod for the production build. -->
    <app.env>UAT</app.env>
    <build.suffix>uat</build.suffix>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>uat</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <properties><app.env>UAT</app.env><build.suffix>uat</build.suffix></properties>
    </profile>
    <profile>
      <id>prod</id>
      <properties><app.env>PROD</app.env><build.suffix>prod</build.suffix></properties>
    </profile>
  </profiles>

  <build>
    <finalName>shopglobal-web-${build.suffix}</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
